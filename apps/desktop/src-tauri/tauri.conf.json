{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Turbodrop",
  "version": "0.1.0",
  "identifier": "com.pouyam.turbodrop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Turbodrop",
        "width": 1120,
        "height": 740,
        "minWidth": 880,
        "minHeight": 600,
        "center": true,
        "decorations": false,
        "transparent": true,
        "visible": false,
        "dragDropEnabled": true,
        "windowEffects": { "effects": ["mica"] }
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob: asset: http://asset.localhost; style-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi", "dmg", "appimage", "deb"],
    "publisher": "Pouyam",
    "homepage": "https://pouyamsmartcity.github.io/turbodrop/",
    "copyright": "© 2026 Pouyam — MIT License",
    "category": "Utility",
    "shortDescription": "Like AirDrop, for every device",
    "longDescription": "Turbodrop sends files between Windows, iPhone, Android, Mac and Linux over your local network. Phones need no app: scan the QR code. End-to-end encrypted, resumable, free and open source. Made by Pouyam.",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["English", "Farsi", "Arabic", "Turkish", "Spanish", "French", "German", "PortugueseBR", "Russian", "SimpChinese", "Japanese"],
        "displayLanguageSelector": false
      }
    }
  }
}
